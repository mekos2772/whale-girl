{
  "name": "mimi-desktop-pet",
  "version": "0.4.0",
  "description": "鲸鱼娘 Mimi 桌宠：DeepSeek Harness 桌面伴侣。支持 DSH 0.1.1-rc.2、任务/工具动作联动、头顶消息气泡、中文输入、桌宠 Agent、分区触摸、投喂与 Live v5 注视表情。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "pet/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "桌宠",
    "deepseek",
    "cordis",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
