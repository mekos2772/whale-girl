{
  "name": "mimi-desktop-pet",
  "version": "0.3.0",
  "description": "鲸鱼娘 Mimi 桌宠：DeepSeek Harness 桌面宠物插件。DSH 启动时桌宠自动陪伴，头顶活动胶囊实时显示当前任务摘要 / 工具调用 / 状态，点击展开快速输入，支持拖拽互动、无级缩放与多项目切换。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "pet/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "桌宠",
    "deepseek",
    "cordis",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
